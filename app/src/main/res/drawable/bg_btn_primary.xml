<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#44FFFFFF">
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@color/primary"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF"/><corners android:radius="16dp"/></shape>
    </item>
</ripple>
